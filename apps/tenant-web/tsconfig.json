{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // monorepo 内存在多个 @types/react 版本（apps/mobile 使用 React 19），
      // pnpm 只会把一个版本提升到 .pnpm/node_modules，antd 依赖的 rc-* 组件
      // 类型会经提升目录解析到另一版本，导致 JSX 组件类型冲突，这里显式钉住 18.x
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"]
}
