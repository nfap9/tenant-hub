generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Auth & Org ====================

model User {
  id            String      @id @default(cuid())
  phone         String      @unique
  username      String
  passwordHash  String
  passwordChangedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  memberships   OrgMember[]
  payments      Payment[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  status      OrgStatus    @default(ACTIVE)
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inviteCode  String?      @unique

  aiModelDefault   String?
  aiDailyBudgetUsd Decimal?  @db.Decimal(10, 2)
  aiEnabled        Boolean   @default(true)

  apartments  Apartment[]
  bills       Bill[]
  deposits    Deposit[]
  leases      Lease[]
  members     OrgMember[]
  invites     OrgInvite[]
  meterReadings MeterReading[]
  roles       Role[]
  aiConversations AiConversation[]
}

model Role {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  description    String?
  system         Boolean        @default(false)
  permissions    String[]
  organizationId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrgMember[]

  @@index([organizationId])
}

model OrgMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model OrgInvite {
  id             String       @id @default(cuid())
  organizationId String
  code           String       @unique
  maxUses        Int          @default(1)
  usedCount      Int          @default(0)
  expiresAt      DateTime
  createdById    String
  usedById       String?
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([code, expiresAt])
}

// ==================== Property ====================

model Apartment {
  id            String    @id @default(cuid())
  organizationId String
  name          String
  address       String
  rentAmount    Decimal   @db.Decimal(12, 2)
  landlordName  String?
  landlordPhone String?
  contractStart DateTime?
  contractEnd   DateTime?
  floors        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id])
  rooms         Room[]
  meterReadings MeterReading[]

  @@index([organizationId, deletedAt])
}

model Room {
  id          String     @id @default(cuid())
  apartmentId String
  roomNo      String
  floor       Int?
  layout      String
  area        Decimal?   @db.Decimal(10, 2)
  furnishings String[]
  status      RoomStatus @default(VACANT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  apartment   Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  leases      Lease[]
  meterReadings MeterReading[]

  @@unique([apartmentId, roomNo])
  @@index([apartmentId, deletedAt])
}

// ==================== Lease & Fees ====================

model Lease {
  id              String      @id @default(cuid())
  organizationId  String
  roomId          String
  tenantName      String?
  tenantPhone     String?
  startDate       DateTime
  endDate         DateTime
  rentAmount      Decimal     @db.Decimal(12, 2)
  rentCycle       RentCycle   @default(MONTHLY)
  waterUnitPrice  Decimal     @db.Decimal(10, 2)
  powerUnitPrice  Decimal     @db.Decimal(10, 2)
  depositAmount   Decimal     @default(0) @db.Decimal(12, 2)
  keyDepositAmount Decimal    @default(0) @db.Decimal(12, 2)
  status          LeaseStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  room            Room        @relation(fields: [roomId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  fees            LeaseFee[]
  bills           Bill[]
  deposits        Deposit[]
  meterReadings   MeterReading[]

  @@index([organizationId, status])
  @@index([roomId, status])
}

model LeaseFee {
  id        String   @id @default(cuid())
  leaseId   String
  type      String   // 管理费、网费、卫生费、电梯费等
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  period    String   // 月、季、年等周期描述
  deletedAt DateTime?

  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId, deletedAt])
}

// ==================== Deposit ====================

model Deposit {
  id             String        @id @default(cuid())
  organizationId String
  leaseId        String
  billId         String?       @unique
  type           DepositType   @default(ROOM)
  amount         Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  deductedAmount Decimal       @default(0) @db.Decimal(12, 2)
  status         DepositStatus @default(UNPAID)
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  lease          Lease         @relation(fields: [leaseId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@unique([leaseId, type])
  @@index([organizationId, status])
}

// ==================== Bills ====================

model Bill {
  id             String      @id @default(cuid())
  organizationId String
  leaseId        String
  billingMethod  BillBillingMethod @default(AUTO)
  billingDate    DateTime
  dueDate        DateTime
  status         BillStatus  @default(UNPAID)
  totalAmount    Decimal     @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal     @default(0) @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  lease          Lease       @relation(fields: [leaseId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  items          BillItem[]
  payments       Payment[]

  @@index([organizationId, status])
  @@index([leaseId, billingDate])
}

model BillItem {
  id          String    @id @default(cuid())
  billId      String
  category    BillCategory
  name        String
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  periodStart DateTime
  periodEnd   DateTime
  note        String?
  deletedAt   DateTime?

  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, deletedAt])
}

model Payment {
  id            String   @id @default(cuid())
  billId        String
  userId        String
  amount        Decimal  @db.Decimal(12, 2)
  waiverAmount  Decimal  @default(0) @db.Decimal(10, 2)
  paidAt        DateTime @default(now())
  method        String
  note          String?

  bill          Bill     @relation(fields: [billId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([billId, paidAt])
}

// ==================== Utility Readings ====================

model MeterReading {
  id             String    @id @default(cuid())
  organizationId String
  apartmentId    String
  roomId         String
  leaseId        String?
  meterType      MeterType
  readingDate    DateTime
  value          Decimal   @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime  @default(now())

  apartment      Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  room           Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  lease          Lease?     @relation(fields: [leaseId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, roomId, meterType, readingDate])
  @@index([leaseId, meterType, readingDate])
}

// ==================== AI ====================

// AI 模型注册表：全局（不属组织），id 为用户定义字符串（创建后不可改），
// AiConversation.modelId 与 Organization.aiModelDefault 均按 id 引用。
// apiKey 明文存储但永不通过 API 回传。
model AiModel {
  id                  String   @id
  displayName         String
  provider            String // anthropic | openai | openai-compat
  providerModel       String
  baseURL             String?
  apiKey              String?
  maxTokens           Int      @default(4096)
  contextWindowTokens Int      @default(128000)
  temperature         Float    @default(0.3)
  tags                String[] @default(["chat"])
  costPerMtu          Json? // { input: number, output: number }（美元/百万 token）
  fallbackTo          String[] @default([])
  authHeader          String?
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AiConversation {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  modelId        String
  status         AiConversationStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toolCalls      AiToolCall[]

  @@index([organizationId, userId, updatedAt])
}

// 会话消息历史由 LangGraph PostgresSaver checkpointer 承载（thread_id = conversationId），
// 本表仅记录工具调用的业务审计信息。
model AiToolCall {
  id             String   @id @default(cuid())
  conversationId String
  toolCallId     String
  toolName       String
  input          Json
  output         Json?
  status         AiToolCallStatus @default(PENDING)
  errorMessage   String?
  durationMs     Int?
  isWrite        Boolean  @default(false)
  confirmedById  String?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toolName, createdAt])
}

model AiPendingAction {
  id             String   @id @default(cuid())
  conversationId String
  toolCallId     String   @unique
  toolName       String
  input          Json
  summary        Json
  status         AiPendingStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([conversationId, status])
}

model AiUsageDaily {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  modelId         String
  date            DateTime @db.Date
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  estimatedCostUsd Decimal @db.Decimal(10, 4) @default(0)
  requestCount    Int      @default(0)

  @@unique([organizationId, userId, modelId, date])
  @@index([organizationId, date])
}

// ==================== Enums ====================

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum RoomStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  SELF_USE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  TERMINATED
  EXPIRED
}

enum RentCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BillStatus {
  UNPAID
  PAID
  VOID
  PENDING
}

enum BillCategory {
  RENT
  UTILITY
  DEPOSIT
  FEE
  OTHER
}

enum BillBillingMethod {
  AUTO
  MANUAL
}

enum DepositType {
  ROOM
  KEY
}

enum DepositStatus {
  UNPAID
  PAID
  REFUNDED
  DEDUCTED
}

enum MeterType {
  WATER
  POWER
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiToolCallStatus {
  PENDING
  SUCCESS
  FAILED
  DENIED
}

enum AiPendingStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}
