# ============================================
# Tenant Hub 本地开发环境变量
# ============================================
# 使用方式：复制本文件为仓库根目录的 .env
# 适用：pnpm dev:all（Docker 启动中间件 + pnpm 启动各服务）
# ============================================

# PostgreSQL（docker-compose.infra.yml 中的 postgres 服务）
POSTGRES_DB=tenant_hub
POSTGRES_USER=postgres
# 【重要】生产环境必须修改为强密码
POSTGRES_PASSWORD=postgres

## API
# Docker 开发环境（docker-compose.infra.yml 将 postgres 暴露到宿主机 5433 端口）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tenant_hub?schema=public

# TOKEN生成密钥，开发环境会自动填充默认值，生产环境必须修改为长度32以上随机字符串
JWT_SECRET=tenant-hub-dev-secret
# TOKEN过期时间，示例：1h, 7d
JWT_EXPIRES_IN=7d

# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5174

# API 服务端口
PORT=4000

# 用户密码加盐轮数
BCRYPT_PASSWORD_SALT_ROUNDS=12

# Web 前端 API Base URL
VITE_API_BASE_URL="http://localhost:4000/api"

# ============================================
# AI Agent（按需启用，配置 AI_MODELS 即可）
# ============================================
# 模型列表，JSON 数组，所有模型均在此配置，系统无内置模型。
# 数组元素的完整格式（Zod schema）见 apps/api/src/ai/models/types.ts：
#   id                 内部 ID，会话与组织默认模型引用它（必填）
#   displayName        前端显示名（必填）
#   provider           API 协议：anthropic | openai | openai-compat（必填）
#   providerModel      供应商侧的模型名（必填）
#   baseURL            API 请求地址（可选，如 https://api.anthropic.com、http://localhost:11434/v1）
#   apiKey             模型密钥（可选，缺省时回落到下方 AI_API_KEY；本地 Ollama 可填 "ollama"）
#   maxTokens          单次最大输出 token，默认 4096
#   contextWindowTokens 上下文窗口大小（仅元数据），默认 128000
#   temperature        默认 0.3
#   tags               默认 ["chat"]
#   costPerMtu         成本估算（美元/百万 token）：{"input": 3, "output": 15}
#   fallbackTo         调用失败时的降级模型 id 链：["other-model-id"]
#   authHeader         认证字段名（可选，缺省按 provider 推导）
#   enabled            默认 true
AI_MODELS='[{"id":"claude-sonnet-4-6","displayName":"Claude Sonnet 4.6","provider":"anthropic","providerModel":"claude-sonnet-4-6","baseURL":"https://api.anthropic.com","maxTokens":8192,"contextWindowTokens":200000,"temperature":0.3,"tags":["chat","strong"],"costPerMtu":{"input":3,"output":15}}]'

# 通用 API 密钥（模型未单独配置 apiKey 时使用）
AI_API_KEY=
