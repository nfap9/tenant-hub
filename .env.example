# ============================================
# Tenant Hub 本地开发环境变量
# ============================================
# 使用方式：复制本文件为仓库根目录的 .env
# 适用：pnpm dev:all（Docker 启动中间件 + pnpm 启动各服务）
# ============================================

# PostgreSQL（docker-compose.infra.yml 中的 postgres 服务）
POSTGRES_DB=tenant_hub
POSTGRES_USER=postgres
# 【重要】生产环境必须修改为强密码
POSTGRES_PASSWORD=postgres

## API
# Docker 开发环境（docker-compose.infra.yml 将 postgres 暴露到宿主机 5433 端口）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tenant_hub?schema=public

# TOKEN生成密钥，开发环境会自动填充默认值，生产环境必须修改为长度32以上随机字符串
JWT_SECRET=tenant-hub-dev-secret
# TOKEN过期时间，示例：1h, 7d
JWT_EXPIRES_IN=7d

# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5174

# API 服务端口
PORT=4000

# 用户密码加盐轮数
BCRYPT_PASSWORD_SALT_ROUNDS=12

# Web 前端 API Base URL
VITE_API_BASE_URL="http://localhost:4000/api"

# ============================================
# AI Agent（按需启用，至少配置一个 Provider 密钥）
# ============================================
# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenAI 兼容端点（DeepSeek / 通义 / Moonshot / 本地 Ollama 等）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
OLLAMA_API_KEY=

# 全局开关
AI_ENABLED=true
AI_DEFAULT_MODEL_ID=claude-sonnet-4-6
AI_ALLOW_LOCAL=false
AI_MAX_ITERATIONS=8
AI_RATE_LIMIT_PER_MIN=20
AI_PENDING_ACTION_TTL_MIN=10
AI_HISTORY_MAX_TURNS=20
# 自定义模型 JSON 数组（覆盖 models.config.ts），格式见 temp/ai-agent-plan.md
AI_CUSTOM_MODELS=
